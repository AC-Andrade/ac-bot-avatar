{
  "name": "@acandrade/ac-bot-avatar-react",
  "version": "1.1.0",
  "description": "Accessible React components for deterministic AC Bot Avatars",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "react",
    "component",
    "avatar",
    "profile-image",
    "bot"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc --build --pretty false",
    "test": "vitest run",
    "pack": "npm pack"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@acandrade/ac-bot-avatar-assets": "^1.1.0",
    "@acandrade/ac-bot-avatar-core": "^1.1.0",
    "@acandrade/ac-bot-avatar-utils": "^1.1.0"
  },
  "peerDependencies": {
    "react": ">=16.14"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AC-Andrade/ac-bot-avatar.git",
    "directory": "packages/react"
  },
  "homepage": "https://acbot.dev",
  "bugs": {
    "url": "https://github.com/AC-Andrade/ac-bot-avatar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
