{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/types/**", "*.tsbuildinfo"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": ["*.tgz"],
      "cache": false
    },
    "lint": {}
  }
}
